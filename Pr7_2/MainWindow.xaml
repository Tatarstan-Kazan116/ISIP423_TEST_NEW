<Window x:Class="Pr7_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pr7_2"
        mc:Ignorable="d"
        Title="Шифр Плейфера" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ключ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="Ключ шифрования:" FontWeight="Bold"/>
            <TextBox x:Name="KeyTextBox" 
                     ToolTip="Введите ключевое слово (только буквы, латиница)"
                     TextChanged="KeyTextBox_TextChanged"/>
            <TextBlock x:Name="KeyError" Foreground="Red" FontSize="10" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Текст -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <Label Content="Текст:" FontWeight="Bold"/>
            <TextBox x:Name="TextTextBox" 
                     ToolTip="Введите текст для шифрования/дешифрования"
                     Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
            <TextBlock x:Name="TextError" Foreground="Red" FontSize="10" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Результат -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Label Content="Результат:" FontWeight="Bold"/>
            <TextBox x:Name="ResultTextBox" IsReadOnly="True" 
                     Height="100" TextWrapping="Wrap" Background="#F0F0F0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Зашифровать" Width="120" Margin="5" 
                    Click="EncryptButton_Click" ToolTip="Зашифровать введённый текст"/>
            <Button Content="Расшифровать" Width="120" Margin="5" 
                    Click="DecryptButton_Click" ToolTip="Расшифровать введённый текст"/>
            <Button Content="Очистить" Width="100" Margin="5" 
                    Click="ClearButton_Click" ToolTip="Очистить все поля"/>
        </StackPanel>

        <!-- Статус -->
        <StatusBar Grid.Row="4">
            <TextBlock x:Name="StatusText" Text="Готов к работе"/>
        </StatusBar>
    </Grid>
</Window>
